{
  "schemaVersion": 1,
  "id": "rapbattle",
  "version": "${version}",
  "name": "Rap Battle",
  "description": "Rap battles against mobs: spit bars on the beat into your mic while an AI judge scores the verse.",
  "authors": [
    "DOMI"
  ],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.rapbattle.RapBattle"
    ],
    "client": [
      "dev.rapbattle.client.RapBattleClient"
    ],
    "modmenu": [
      "dev.rapbattle.client.ModMenuIntegration"
    ]
  },
  "depends": {
    "fabricloader": ">=0.18.6",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": ">=0.141.6+1.21.11"
  },
  "mixins": [
    "rapbattle.mixins.json",
    {
      "config": "rapbattle.client.mixins.json",
      "environment": "client"
    }
  ]
}